# Copy to .env and fill in. Every variable the workspace reads is listed here —
# if you add one in code, add it here too, with a sentence saying what it does.

# ---------------------------------------------------------------- cms-server

# PostgreSQL connection string. Docker Compose supplies this automatically.
DATABASE_URL=postgres://ainam:ainam@localhost:5432/ainam

# Port the content and admin API listens on.
PORT=8787

# Signs sessions and tokens. Must be at least 32 characters.
#
# The value below is a development placeholder so that `cp .env.example .env &&
# docker compose up` works from a clean checkout. It is published in a public
# repository, so it is public knowledge — cms-server refuses to start with it
# when NODE_ENV=production. Generate a real one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=development-only-secret-not-for-any-deployment

# Public URL of the cms-server itself, used to build callback URLs.
BETTER_AUTH_URL=http://localhost:8787

# Browser origin allowed to call the admin API. The content API is not
# browser-facing and is not covered by this.
DASHBOARD_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- dashboard

# Where the dashboard sends its admin API requests.
NEXT_PUBLIC_CMS_URL=http://localhost:8787
