{
  "name": "@ainam/next",
  "version": "0.0.0",
  "type": "module",
  "description": "AINAM adapter for the Next.js App Router \u2014 cached reads, webhook revalidation, preview mode, and rich-text rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanSirPROXx/ainam.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/JanSirPROXx/ainam#readme",
  "bugs": {
    "url": "https://github.com/JanSirPROXx/ainam/issues"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@ainam/core": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
