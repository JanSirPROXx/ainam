{
  "name": "@ainam/next",
  "version": "0.0.0",
  "type": "module",
  "description": "AINAM adapter for the Next.js App Router \u2014 cached reads, webhook revalidation, preview mode.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ainam/core": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "devDependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
