{
  "name": "@ainam/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and derived types shared by the CMS server, the dashboard and the SDK.",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs"
}
