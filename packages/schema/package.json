{
  "name": "@ainam/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, derived types and the shared permission model. Internal: never published.",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./access": {
      "import": "./dist/access.mjs",
      "require": "./dist/access.cjs"
    },
    "./rich-text": {
      "import": "./dist/rich-text.mjs",
      "require": "./dist/rich-text.cjs"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-auth": "1.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs"
}
