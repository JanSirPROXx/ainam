{
  "name": "@ainam/ui",
  "version": "0.0.0",
  "type": "module",
  "description": "The AINAM design system as React components and CSS tokens.",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "files": ["dist", "styles"],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "react": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
